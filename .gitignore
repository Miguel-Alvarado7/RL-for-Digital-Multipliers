# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter / IDE
.ipynb_checkpoints/
.vscode/
.idea/

# Experiment outputs
# Experiment outputs: se versionan los artefactos pequenos (circuitos, curvas,
# tablas Q) pero NUNCA los returns_*.csv, que son una fila por episodio y
# pesan GB. 'out/**' ignora ficheros; '!out/**/' permite descender por los
# directorios (si no, las negaciones de dentro no se aplican).

# Verilog build artifacts (keep template + source)
*.vcd
Environment/verilog/multiplier.v
Environment/verilog/multipliermax.v
Environment/verilog/multiplier_8bit_tb.v
Environment/verilog/simv
*.out
ref_simv

# OS
Thumbs.db
.DS_Store

# Negaciones al final: en .gitignore gana la ULTIMA regla que casa, asi que
# estas deben ir despues de patrones globales como *.npy.
!out/**/
!out/**/*.v
!out/**/*.png
!out/**/*.npy
